# yt-automation configuration.
#
#   cp .env.example .env
#
# Every value below is optional; the defaults shown are the built-in ones.
# The two switches that matter most are at the very bottom (DRY_RUN,
# AUTO_APPROVE) — the pipeline will not touch a real channel unless you say so.

# ============================================================================
# REQUIRED for live publishing (absent = fully offline, which is the default)
# ============================================================================

# --- LLM: pick any number of free providers. `auto` uses the best one present.

# Every free option below needs no card and no billing account. Set as many as
# you like; `auto` picks the one with the most headroom and the pipeline falls
# over to the next when one is rate limited or out of daily quota.
#   https://console.groq.com/keys      GROQ_API_KEY      14,400 requests/day
#   https://build.nvidia.com           NVIDIA_API_KEY    40 requests/minute
#   https://aistudio.google.com/apikey GEMINI_API_KEY        20 requests/day
# ANTHROPIC_API_KEY=sk-ant-...        # paid, no free tier

# Pin a backend instead of letting `auto` choose. Setting a provider whose key is
# missing fails loudly rather than quietly falling back to a billable one.
# LLM_PROVIDER=auto            # auto | groq | nvidia | gemini | anthropic

# Google OAuth client secrets, downloaded from the Google Cloud console
# (YouTube Data API v3 + YouTube Analytics API enabled).
#   cp ~/Downloads/client_secret_*.json secrets/client_secret.json
# The filename is the default; override it with CLIENT_SECRET_PATH.

# ============================================================================
# FILES AND PATHS
# ============================================================================
# DATA_DIR moves the database, media and logs together. Override the three
# individual paths only if you need to scatter them.
# DATA_DIR=./data
# MEDIA_DIR=./data/media
# LOG_DIR=./data/logs
# SECRETS_DIR=./secrets
# DB_PATH=./data/ytauto.db
# TOKEN_PATH=./secrets/token.json
# CLIENT_SECRET_PATH=./secrets/client_secret.json

# ============================================================================
# CHANNEL
# ============================================================================
# Filled in automatically by `ytauto auth`; set by hand for a second channel.
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_DAILY_QUOTA=10000
TIMEZONE=Asia/Kolkata

# ============================================================================
# CONTENT DIRECTION
# ============================================================================
NICHE=tech,ai,gadgets
LANGUAGE=English
# Free text; the more specific this is the better the research angles.
# TARGET_AUDIENCE=busy professionals who follow tech news but not the jargon
BRAND=Tech Tricks Hub
BRAND_TAGLINE=Daily tech explained fast
BRAND_URL=https://www.tech-tricks-hub.com

# One long-form + two Shorts a day. 24h HH:MM, comma separated.
LONGFORM_TIMES=18:30
SHORTS_TIMES=12:30,20:30
MIN_GAP_MINUTES=90
MAX_TOPICS_PER_DAY=12

# ============================================================================
# SOURCES
# ============================================================================
# RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml
# Optional Reddit sources, off by default. Reddit's .rss gives neither the
# article URL nor the article text any more, so these arrive as bare headlines
# that duplicate the RSS feeds above -- and they cost a 15s throttle per
# subreddit plus frequent anonymous rate limits (429). Self posts/AMAs are
# filtered out if you enable it.
# SUBREDDITS=technology,artificial,gadgets

# ============================================================================
# LLM
# ============================================================================
# Dateless id = a moving alias; set a dated id to pin an exact snapshot.
# LLM_PROVIDER=auto

# Anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_MODEL_FAST=claude-haiku-4-5-20251001

# Gemini (used when LLM_PROVIDER resolves to gemini). Both serve on the free
# tier. The free tier is rate limited per minute — if you raise --count and see
# 429s, lower it rather than raising LLM_ATTEMPTS.
# --- LLM provider -------------------------------------------------------
# LLM_PROVIDER=auto walks this list and takes the first key present:
#   groq    -> 14,400 requests/day free   (console.groq.com, no credit card)
#   nvidia  -> 40 requests/minute free   (build.nvidia.com, free dev program)
#   gemini  -> 20 requests/day free      (Google AI Studio)
#   anthropic -> paid, no free tier
#
# At 2-8 calls per video, Groq alone covers many videos a day. Add more than
# one and the pipeline keeps going when one runs out. Set LLM_PROVIDER
# explicitly (e.g. LLM_PROVIDER=groq) to pin one: you then get that provider or
# a clear "key not set" error, never a silent switch.
# GROQ_API_KEY=gsk_...
# NVIDIA_API_KEY=nvapi-...
# GEMINI_API_KEY=...
# GROQ_MODEL=qwen/qwen3.8-27b
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Tracking aliases, so a model retirement does not need a config change.
# gemini-2.5-flash now returns HTTP 404 for newer API keys, despite still
# appearing in `ytauto llm --list-models`; the alias is how you avoid that.
# For a pinned model, use gemini-3.8-flash (what the API currently recommends).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
# LLM_MAX_TOKENS=8000
# LLM_TIMEOUT_S=180
# Pace requests. The Gemini free tier allows 20 generateContent calls PER DAY
# per model per project -- not per minute; the error message's "retry in 31s"
# is misleading. Expect 2-4 videos a day on this tier.
# GEMINI_MIN_INTERVAL_S=3.2
# Extra body beats to request when a long-form script comes back short. A single
# request for 1200 words reliably returns ~200, so volume is added as sized
# beats instead. 0 disables and lets validation reject short scripts.
# LONGFORM_MAX_BEATS=6
# LLM_ATTEMPTS=4

# ============================================================================
# TOPIC SELECTION
# ============================================================================
# A topic below MIN_NICHE_SCORE does not mention the niche and is skipped;
# below MIN_TOTAL_SCORE it is simply not interesting enough right now.
MIN_NICHE_SCORE=0.3
MIN_TOTAL_SCORE=0.35
TOPIC_HALF_LIFE_H=24

# ============================================================================
# SCRIPT AND RENDER TARGETS
# ============================================================================
LONGFORM_TARGET_S=480
SHORTS_TARGET_S=45
WORDS_PER_MINUTE=150
TITLE_MAX_LEN=70

# TTS_ENGINE=auto picks macOS `say` when present, else falls back to silence.
# TTS_ENGINE=say|none
TTS_VOICE=Samantha
TTS_RATE_WPM=175
# Leave empty to auto-detect the bundled binary in vendor/ffmpeg.
# FFMPEG_PATH=
RENDER_WORKERS=2

# ============================================================================
# SAFETY SWITCHES
# ============================================================================

# DRY_RUN=1 (default): plan, script, render, and log — but never call upload.
# Set to 0 only once `ytauto doctor` is clean.
DRY_RUN=1

# AUTO_APPROVE=1: render and upload scripted videos without a human pressing
# approve. This is what makes the loop fully unattended. Note that a script
# built from the offline template (no ANTHROPIC_API_KEY) is NEVER auto-approved
# even with this on, no matter what ALLOW_DEGRADED says.
AUTO_APPROVE=0

# ALLOW_DEGRADED=1: let offline-template scripts pass validation so you can
# exercise and review the whole pipeline without an API key. Produces content
# that is not fact-checked. Dry runs and review only.
ALLOW_DEGRADED=0

# --- Rumble upload (Playwright; no public API, so browser automation) ---
# RUMBLE_EMAIL=you@example.com
# RUMBLE_PASSWORD=
# RUMBLE_USE_COOKIES=1
# RUMBLE_AUTO_PUBLISH=0
